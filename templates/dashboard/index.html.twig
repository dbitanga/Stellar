{% extends 'dashboard/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stat-value {
            font-size: 2rem;
            color: #A8C4DA;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="row g-3">
        {% for label, value in stats %}
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="small text-body-secondary">{{ label }}</div>
                        <div class="stat-value">{{ value }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}