{% extends 'dashboard/layout.html.twig' %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-body-secondary mb-0">Group your laptops into categories.</p>
        <button type="button" class="btn btn-primary" data-crud-open
                data-crud-modal="#category-modal"
                data-crud-title="Add Category"
                data-crud-action="{{ path('app_dashboard_category_new') }}">Add category</button>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle w-100" data-datatable>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.name }}</td>
                            <td>{{ category.description }}</td>
                            <td>{{ category.products|length }}</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-primary" data-crud-open
                                        data-crud-modal="#category-modal"
                                        data-crud-title="Edit Category"
                                        data-crud-action="{{ path('app_dashboard_category_edit', {id: category.id}) }}"
                                        data-crud-values="{{ {name: category.name, description: category.description}|json_encode }}">Edit</button>

                                <form method="post" class="d-inline"
                                      action="{{ path('app_dashboard_category_delete', {id: category.id}) }}"
                                      data-confirm="Delete {{ category.name }}?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category' ~ category.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="category-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            {{ form_start(form, {attr: {class: 'modal-content'}}) }}
                <div class="modal-header">
                    <h2 class="modal-title fs-5">Category</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{ form_widget(form) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}