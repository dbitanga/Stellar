<style>
    .header-brand {
        font-size: clamp(1.1rem, 1.4vw, 1.6rem);
        letter-spacing: 0.05em;
    }
</style>

<div class="d-flex align-items-center justify-content-between gap-3 h-100 px-4 border-bottom bg-body-tertiary">
    <span class="header-brand">{{ site_name }}</span>
    <div class="d-flex align-items-center gap-3">
        <a class="small text-body-secondary text-decoration-none text-truncate" href="{{ path('app_profile') }}">
            {{ user_name }} <span class="badge text-bg-secondary">{{ role_label }}</span>
        </a>
        <form method="post" action="{{ path('app_logout') }}" class="m-0">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
        </form>
    </div>
</div>
