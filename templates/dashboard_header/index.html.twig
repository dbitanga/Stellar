<style>
    .header-brand {
        font-size: clamp(1.1rem, 1.4vw, 1.6rem);
        letter-spacing: 0.05em;
    }

    /* Same dark blue as the store's header image. */
    .dashboard-header-bar {
        background-color: #181E28;
        /* Right edge matches the store header, where Account / Log Out sit 5% from the edge. */
        padding: 0 5% 0 1.5rem;
    }

    /* Same plain blue text links as the store header (Dashboard, Account, Log Out). */
    .dashboard-header-link {
        color: #A8C4DA;
        font-family: 'Goldman', sans-serif;
        font-size: 0.9rem;
        letter-spacing: 0.03em;
        text-decoration: none;
        white-space: nowrap;
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
    }

    .dashboard-header-link:hover {
        color: #A8C4DA;
        text-decoration: underline;
    }
</style>

<div class="d-flex align-items-center justify-content-between gap-3 h-100 border-bottom dashboard-header-bar">
    <div class="d-flex align-items-center gap-4">
        <span class="header-brand">{{ site_name }}</span>
        <a class="dashboard-header-link" href="{{ path('app_home') }}">Home</a>
    </div>
    <div class="d-flex align-items-center gap-4">
        <a class="small text-body-secondary text-decoration-none text-truncate" href="{{ path('app_profile') }}">
            {{ user_name }} <span class="badge text-bg-secondary">{{ role_label }}</span>
        </a>
        <form method="post" action="{{ path('app_logout') }}" class="m-0">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="dashboard-header-link">Log Out</button>
        </form>
    </div>
</div>
