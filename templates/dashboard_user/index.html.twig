{% extends 'dashboard/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .row-hidden td {
            opacity: 0.55;
        }

        .row-hidden td:last-child {
            opacity: 1;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <p class="text-body-secondary mb-0">Manage the admin and staff accounts that can log in here.</p>
        <button type="button" class="btn btn-primary text-nowrap" data-crud-open
                data-crud-modal="#user-modal"
                data-crud-title="Add User"
                data-crud-action="{{ path('app_dashboard_user_new') }}">Add user</button>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle w-100" data-datatable>
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Date created</th>
                        <th data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="{{ user.active ? '' : 'row-hidden' }}">
                            <td>{{ user.username }}</td>
                            <td>{{ user.fullName }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.roleLabel }}</td>
                            <td>
                                {% if user.active %}
                                    <span class="badge text-bg-success">Active</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Disabled</span>
                                {% endif %}
                            </td>
                            <td data-order="{{ user.createdAt|date('U') }}">{{ user.createdAt|date('M j, Y') }}</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-primary" data-crud-open
                                        data-crud-modal="#user-modal"
                                        data-crud-title="Edit User"
                                        data-crud-action="{{ path('app_dashboard_user_edit', {id: user.id}) }}"
                                        data-crud-values="{{ {
                                            username: user.username,
                                            firstName: user.firstName,
                                            middleName: user.middleName,
                                            lastName: user.lastName,
                                            email: user.email,
                                            role: user.role
                                        }|json_encode }}">Edit</button>

                                {% if user != app.user %}
                                    <form method="post" class="d-inline"
                                          action="{{ path('app_dashboard_user_toggle', {id: user.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_user' ~ user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">{{ user.active ? 'Disable' : 'Enable' }}</button>
                                    </form>

                                    <form method="post" class="d-inline"
                                          action="{{ path('app_dashboard_user_delete', {id: user.id}) }}"
                                          data-confirm="Delete {{ user.username }} permanently?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="user-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            {{ form_start(form, {attr: {class: 'modal-content'}}) }}
                <div class="modal-header">
                    <h2 class="modal-title fs-5">User</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{ form_widget(form) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
