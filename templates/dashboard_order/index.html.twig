{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_badges.html.twig' as badges %}

{% block content %}
    <p class="text-body-secondary mb-3">Process customer orders from payment to delivery.</p>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle w-100" data-datatable>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td data-order="{{ order.id }}">#{{ order.id }}</td>
                            <td data-order="{{ order.createdAt|date('U') }}">{{ order.createdAt|date('M j, Y g:i A') }}</td>
                            <td>{{ order.shippingName }}</td>
                            <td>{{ order.itemCount }}</td>
                            <td data-order="{{ order.totalAmount }}">₱{{ order.totalAmount|number_format(2) }}</td>
                            <td>{{ order.paymentMethod }} {{ badges.payment_status(order.paymentStatus) }}</td>
                            <td>{{ badges.order_status(order.orderStatus) }}</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-primary" href="{{ path('app_dashboard_order_show', {id: order.id}) }}">View</a>
                                {% include 'dashboard_order/_actions.html.twig' with {back: 'app_dashboard_order_index'} %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
