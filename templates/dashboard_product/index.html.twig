{% extends 'dashboard/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .product-thumb {
            width: 45px;
            height: 45px;
            object-fit: cover;
            border-radius: 6px;
            background: #0b1320;
        }

        .row-hidden td {
            opacity: 0.55;
        }

        .row-hidden td:last-child {
            opacity: 1;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-body-secondary mb-0">Manage the laptop listings shown on the website.</p>
        <button type="button" class="btn btn-primary" data-crud-open
                data-crud-modal="#product-modal"
                data-crud-title="Add Product"
                data-crud-action="{{ path('app_dashboard_product_new') }}">Add product</button>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle w-100" data-datatable>
                <thead>
                    <tr>
                        <th data-orderable="false">Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Tier</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr class="{{ product.visible ? '' : 'row-hidden' }}">
                            <td><img class="product-thumb" src="{{ asset(product.imagePath) }}" alt="{{ product.name }}"></td>
                            <td>{{ product.name }}</td>
                            <td>{{ product.category.name }}</td>
                            <td>{{ product.tier }}</td>
                            <td data-order="{{ product.price }}">₱{{ product.price|number_format(2) }}</td>
                            <td>{{ product.stock }}</td>
                            <td>
                                {% if product.visible %}
                                    <span class="badge text-bg-success">Visible</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Hidden</span>
                                {% endif %}
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-primary" data-crud-open
                                        data-crud-modal="#product-modal"
                                        data-crud-title="Edit Product"
                                        data-crud-action="{{ path('app_dashboard_product_edit', {id: product.id}) }}"
                                        data-crud-values="{{ {
                                            name: product.name,
                                            category: product.category.id,
                                            tier: product.tier,
                                            price: product.price,
                                            stock: product.stock,
                                            processor: product.processor,
                                            graphics: product.graphics,
                                            ram: product.ram,
                                            storage: product.storage,
                                            imagePath: product.imagePath,
                                            visible: product.visible
                                        }|json_encode }}">Edit</button>

                                <form method="post" class="d-inline"
                                      action="{{ path('app_dashboard_product_toggle', {id: product.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_product' ~ product.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">{{ product.visible ? 'Hide' : 'Show' }}</button>
                                </form>

                                <form method="post" class="d-inline"
                                      action="{{ path('app_dashboard_product_delete', {id: product.id}) }}"
                                      data-confirm="Delete {{ product.name }} permanently?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_product' ~ product.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="product-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            {{ form_start(form, {attr: {class: 'modal-content'}}) }}
                <div class="modal-header">
                    <h2 class="modal-title fs-5">Product</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{ form_widget(form) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}