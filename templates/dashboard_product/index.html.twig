{% extends 'dashboard/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .product-thumb {
            width: 45px;
            height: 45px;
            object-fit: cover;
            border-radius: 6px;
            background: #0b1320;
        }

        .row-hidden td {
            opacity: 0.55;
        }

        .row-hidden td:last-child {
            opacity: 1;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-body-secondary mb-0">Manage the laptop listings shown on the website.</p>
        <button type="button" class="btn btn-primary" data-crud-open
                data-crud-modal="#product-modal"
                data-crud-title="Add Product"
                data-crud-action="{{ path('app_dashboard_product_new') }}">Add product</button>
    </div>

    <form method="get" action="{{ path('app_dashboard_product_index') }}" class="card mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-12 col-md-4 col-xl-3">
                <label for="filter-q" class="form-label small mb-1">Search</label>
                <input type="search" id="filter-q" name="q" value="{{ filter.q }}" maxlength="100"
                       class="form-control" placeholder="Name, processor, graphics…">
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label for="filter-category" class="form-label small mb-1">Category</label>
                <select id="filter-category" name="category" class="form-select">
                    <option value="">All</option>
                    {% for category in categories %}
                        <option value="{{ category.value }}" {{ filter.category == category.value ? 'selected' }}>{{ category.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label for="filter-tier" class="form-label small mb-1">Tier</label>
                <select id="filter-tier" name="tier" class="form-select">
                    <option value="">All</option>
                    {% for tier in tiers %}
                        <option value="{{ tier }}" {{ filter.tier == tier ? 'selected' }}>{{ tier }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label for="filter-status" class="form-label small mb-1">Status</label>
                <select id="filter-status" name="status" class="form-select">
                    <option value="">All</option>
                    {% for value, label in {visible: 'Visible', hidden: 'Hidden', low_stock: 'Low stock'} %}
                        <option value="{{ value }}" {{ filter.status == value ? 'selected' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-4 col-xl-1">
                <div class="form-check mb-2">
                    <input type="checkbox" id="filter-mine" name="mine" value="1" class="form-check-input" {{ filter.mine ? 'checked' }}>
                    <label for="filter-mine" class="form-check-label">Created<br>by me</label>
                </div>
            </div>
            <div class="col-12 col-md-4 col-xl-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filter</button>
                {% if filter.active %}
                    <a href="{{ path('app_dashboard_product_index') }}" class="btn btn-outline-secondary flex-fill">Clear</a>
                {% endif %}
            </div>
        </div>
    </form>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle w-100" data-datatable>
                <thead>
                    <tr>
                        <th data-orderable="false">Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Tier</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th>Created by</th>
                        <th data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr class="{{ product.visible ? '' : 'row-hidden' }}">
                            <td><img class="product-thumb" src="{{ asset(product.imagePath) }}" alt="{{ product.name }}"></td>
                            <td>{{ product.name }}</td>
                            <td>{{ product.category.label }}</td>
                            <td>{{ product.tier }}</td>
                            <td data-order="{{ product.price }}">₱{{ product.price|number_format(2) }}</td>
                            <td>{{ product.stock }}</td>
                            <td>
                                {% if product.visible %}
                                    <span class="badge text-bg-success">Visible</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Hidden</span>
                                {% endif %}
                            </td>
                            <td>{{ product.createdBy.username ?? '—' }}</td>
                            <td class="text-nowrap">
                                {% if is_granted('PRODUCT_MANAGE', product) %}
                                <button type="button" class="btn btn-sm btn-primary" data-crud-open
                                        data-crud-modal="#product-modal"
                                        data-crud-title="Edit Product"
                                        data-crud-action="{{ path('app_dashboard_product_edit', {id: product.id}) }}"
                                        data-crud-values="{{ {
                                            name: product.name,
                                            category: product.category.value,
                                            tier: product.tier,
                                            price: product.price,
                                            stock: product.stock,
                                            processor: product.processor,
                                            graphics: product.graphics,
                                            ram: product.ram,
                                            storage: product.storage,
                                            imagePath: product.imagePath,
                                            visible: product.visible
                                        }|json_encode }}">Edit</button>

                                <form method="post" class="d-inline"
                                      action="{{ path('app_dashboard_product_toggle', {id: product.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_product' ~ product.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">{{ product.visible ? 'Hide' : 'Show' }}</button>
                                </form>

                                <form method="post" class="d-inline"
                                      action="{{ path('app_dashboard_product_delete', {id: product.id}) }}"
                                      data-confirm="Delete {{ product.name }} permanently?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_product' ~ product.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                                {% else %}
                                    <span class="small text-body-secondary">View only</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="product-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            {{ form_start(form, {attr: {class: 'modal-content'}}) }}
                <div class="modal-header">
                    <h2 class="modal-title fs-5">Product</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{ form_widget(form) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}