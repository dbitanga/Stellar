{% extends 'dashboard/layout.html.twig' %}

{% block content %}
    {% set user = app.user %}
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Account</h2>
                        <button type="button" class="btn btn-sm btn-primary"
                                data-bs-toggle="modal" data-bs-target="#profile-modal">Edit profile</button>
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-body-secondary fw-normal">Username</dt>
                        <dd class="col-sm-8">{{ user.username }}</dd>

                        <dt class="col-sm-4 text-body-secondary fw-normal">Name</dt>
                        <dd class="col-sm-8">{{ user.fullName ?: '—' }}</dd>

                        <dt class="col-sm-4 text-body-secondary fw-normal">Email</dt>
                        <dd class="col-sm-8">{{ user.email ?: '—' }}</dd>

                        <dt class="col-sm-4 text-body-secondary fw-normal">Mobile number</dt>
                        <dd class="col-sm-8">{{ user.mobileNumber ?: '—' }}</dd>

                        <dt class="col-sm-4 text-body-secondary fw-normal">Role</dt>
                        <dd class="col-sm-8">{{ user.roleLabel }}</dd>

                        <dt class="col-sm-4 text-body-secondary fw-normal">Date created</dt>
                        <dd class="col-sm-8 mb-0">{{ user.createdAt|date('M j, Y') }}</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">Change password</h2>
                    {{ form_start(form) }}
                        {{ form_widget(form) }}
                        <button type="submit" class="btn btn-primary">Change password</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="profile-modal" tabindex="-1" aria-labelledby="profile-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            {{ form_start(profile_form, {attr: {class: 'modal-content'}}) }}
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="profile-modal-title">Edit profile</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{ form_widget(profile_form) }}
                    <p class="form-text mb-0">Your username and role can only be changed by an admin.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            {{ form_end(profile_form) }}
        </div>
    </div>
{% endblock %}
